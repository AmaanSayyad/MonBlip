{
  "name": "mm-plugin-monblip",
  "version": "0.1.0",
  "description": "Fund a MonBlip round on Monad and sign it with the MetaMask Agent Wallet.",
  "license": "MIT",
  "type": "module",
  "keywords": ["oclif-plugin"],
  "files": ["dist", "oclif.manifest.json", "skills", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && oclif manifest",
    "prepack": "tsc -p tsconfig.json && oclif manifest"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "monblip": {
        "description": "Trade a short BTC round on the MonBlip house"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": ">=6.2.0",
    "capabilities": [],
    "commands": [
      {
        "id": "monblip:desk",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "monblip:fund",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["network"],
        "targetChains": [143]
      },
      {
        "id": "monblip:round",
        "capabilities": ["wallet-submit"],
        "dataAccess": [],
        "targetChains": [143]
      }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.2.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^7.2.0",
    "oclif": "^4",
    "typescript": "^5"
  }
}
